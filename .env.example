AUTODIAG_MODEL_MAX_CALLS=8
AUTODIAG_MODEL_TIMEOUT_S=30
AUTODIAG_MODEL_SESSION_BUDGET_CNY=5
AUTODIAG_CAN_INTERFACE=vcan0
