{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "AutoDiag Linux Debug",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/autodiag/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "linux-debug", "configurePreset": "linux-debug"}],
  "testPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}}
  ]
}
